# Database Configuration
# "db" is the PostgreSQL service name in compose.yaml (single-host). For a
# multi-host deployment, replace "db" with that host's address (see
# docs/SCALING.md).
DATABASE_URL=postgresql://mcpuser:mcppassword@db:5432/mcpdb

# Redis Configuration (Streamable HTTP session store; see docs/SCALING.md)
# "redis" is the Redis service name in compose.yaml (single-host). For a
# multi-host deployment, replace "redis" with that host's address.
REDIS_URL=redis://redis:6379/0

# Caddy reverse-proxy upstreams (single-host default shown; for multi-host,
# point these at the web/mcp hosts' addresses instead). See docs/SCALING.md.
WEB_UPSTREAM=web:5000
MCP_UPSTREAM=mcp:5000

# Custom domain for production (Let's Encrypt via Caddyfile.prod). Leave unset
# for local development (defaults to localhost / lvh.me).
# ACCEL_MCP_DOMAIN=mcp.example.com

# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production
FLASK_APP=run.py
FLASK_ENV=development

# Session Configuration
SESSION_LIFETIME_HOURS=12

# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Initial Admin User
ADMIN_USERNAME=accel
ADMIN_PASSWORD=universe

# Docker Environment
DOCKER_ENV=1

# Template Repository Configuration
# For local testing, use file:// URL
# TEMPLATE_REPOSITORY_URL=file:///app/data/builtin_templates
TEMPLATE_REPOSITORY_URL=https://raw.githubusercontent.com/t-ogawa-dev/octopus-mcp-proxy/main/data/builtin_templates
TEMPLATE_INDEX_FILE=index.yaml
TEMPLATE_VERSIONS_DIR=versions